<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Spezi</AssemblyName>
    <RootNamespace>Spezi.App</RootNamespace>
    <ApplicationIcon>Assets\Spezi.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <!-- Self-tests ship only in Debug unless explicitly requested:
       dotnet build -c Release -p:SpeziSelfTests=true -->
  <PropertyGroup>
    <SpeziSelfTests Condition="'$(SpeziSelfTests)' == '' and '$(Configuration)' == 'Debug'">true</SpeziSelfTests>
    <DefineConstants Condition="'$(SpeziSelfTests)' == 'true'">$(DefineConstants);SPEZI_SELFTESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SpeziSelfTests)' != 'true'">
    <Compile Remove="SelfTests/**" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Spezi.ico" />
    <Resource Include="Assets\SpeziMark.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spezi.Core\Spezi.Core.csproj" />
  </ItemGroup>
</Project>
