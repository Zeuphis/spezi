<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Spezi</AssemblyName>
    <Version>1.1.1</Version>
    <RootNamespace>Spezi.App</RootNamespace>
    <ApplicationIcon>Assets\Spezi.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Spezi.ico" />
    <Resource Include="Assets\SpeziMark.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spezi.Core\Spezi.Core.csproj" />
  </ItemGroup>
</Project>
