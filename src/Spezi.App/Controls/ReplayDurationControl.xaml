<UserControl x:Class="Spezi.App.ReplayDurationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,12,14,10">
    <StackPanel>
      <Grid Margin="0,0,0,9">
        <TextBlock Text="Replay length" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
        <Border HorizontalAlignment="Right" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="9,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="DurationText" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
      <Slider x:Name="DurationSlider" Minimum="15" Maximum="300" TickFrequency="15" SmallChange="15" LargeChange="60"
              IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="180" ValueChanged="SliderChanged"
              Height="28" FocusVisualStyle="{StaticResource FocusVisual}" Cursor="Hand"
              AutomationProperties.Name="Replay length in seconds">
        <Slider.Template>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Background="{StaticResource Line}" Height="4" CornerRadius="2" Margin="10,0" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="10,0,0,0"/></Border></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="20" Height="28">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="Point" Width="20" Height="20" Fill="{DynamicResource Accent}" Stroke="{StaticResource Field}" StrokeThickness="3" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Point" Property="Fill" Value="{DynamicResource AccentHover}"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Point" Property="StrokeThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Slider.Template>
      </Slider>
      <Canvas x:Name="Marks" Height="28" SizeChanged="MarksSizeChanged" IsHitTestVisible="False"/>
    </StackPanel>
  </Border>
</UserControl>
