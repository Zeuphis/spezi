<UserControl x:Class="Spezi.App.CapturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16,18,8">
      <StackPanel MaxWidth="900">
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,12">
          <StackPanel>
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusMark" Width="10" Height="10" Fill="{StaticResource Muted}" Margin="0,0,10,0"/>
                <TextBlock x:Name="StatusText" Text="Replay off" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <ToggleButton x:Name="ReplayToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                            AutomationProperties.Name="Replay" Checked="ReplayToggled" Unchecked="ReplayToggled"/>
            </Grid>
          </StackPanel>
        </Border>

        <Button x:Name="ClipButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Click="SaveClip" AutomationProperties.Name="Save clip">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Data="M12,3 V13 M7,9 L12,14 L17,9 M5,18 H19" Stroke="{DynamicResource AccentInk}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
              <TextBlock Text="Save clip" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource HotkeyChip}" Margin="10,0,0,0" Background="#D7F8EA" BorderBrush="#1C6B4A">
              <TextBlock x:Name="ClipHotkeyText" FontSize="11.5" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"/>
            </Border>
          </Grid>
        </Button>
        <Button x:Name="RecordButton" Style="{StaticResource RecordButton}" Margin="0,8,0,0" Click="ToggleRecord" AutomationProperties.Name="Start recording">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Ellipse Width="10" Height="10" Fill="{StaticResource Record}" Margin="0,0,8,0"/>
              <TextBlock x:Name="RecordLabel" Text="Start recording" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
              <TextBlock x:Name="RecordTime" Margin="8,0,0,0" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8,3" Background="{StaticResource Field}">
              <TextBlock x:Name="RecordHotkeyText" FontSize="11.5" Foreground="{StaticResource Muted}"/>
            </Border>
          </Grid>
        </Button>
        <TextBlock x:Name="ClipHint" Style="{StaticResource MutedText}" Margin="2,8,2,0" Visibility="Collapsed"/>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
          <StackPanel>
            <Grid>
              <TextBlock Text="Audio" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="SystemBox" Content="App / system audio" Margin="0,0,14,0" Checked="SystemToggled" Unchecked="SystemToggled"/>
                <CheckBox x:Name="MicBox" Content="Microphone" Margin="0" Checked="MicToggled" Unchecked="MicToggled"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="AudioHint" Text="Game audio and voice chat are included." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/>
            <Button Content="Choose audio sources  ›" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,5,0,0" Click="OpenSettingsClick"/>
          </StackPanel>
        </Border>

        <Grid Margin="0,18,0,8">
          <TextBlock Text="Recent clips" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="View all  ›" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="ShowAll"/>
        </Grid>
        <TextBlock x:Name="EmptyClips" Text="No clips yet. Save a moment to see it here." Style="{StaticResource MutedText}" Margin="0,8,0,12" TextAlignment="Center"/>
        <ItemsControl x:Name="RecentList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="84" Height="48" CornerRadius="6" Background="{StaticResource Field}" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="PlayRecent" ToolTip="Open in default player" AutomationProperties.Name="Open in default player" VerticalAlignment="Center">
                    <Path Data="M6,4 L14,9 L6,14 Z" Fill="{StaticResource Ink}" Width="10" Height="12" Stretch="Fill" Margin="1,0,0,0"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,8">
      <Grid MaxWidth="932">
        <Button x:Name="FolderButton" HorizontalAlignment="Left" Click="OpenFolder" ToolTip="Open folder" AutomationProperties.Name="Open save location"
                Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="4,4">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Field}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <StackPanel Orientation="Horizontal">
            <Path Data="M2,6 H8 L10,8 H20 V18 H2 Z" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="16" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="FolderText" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Width="30" Height="30" Click="OpenSettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings" Margin="0,0,8,0">
            <Grid Width="14" Height="14">
              <Ellipse Stroke="{StaticResource Muted}" StrokeThickness="1.3" Margin="2.6"/>
              <Path Stroke="{StaticResource Muted}" StrokeThickness="1.3" StrokeStartLineCap="Round"
                    Data="M7,0.6 V2.4 M7,11.6 V13.4 M0.6,7 H2.4 M11.6,7 H13.4 M2.4,2.4 L3.6,3.6 M10.4,10.4 L11.6,11.6 M11.6,2.4 L10.4,3.6 M3.6,10.4 L2.4,11.6" Stretch="Fill"/>
            </Grid>
          </Button>
          <TextBlock x:Name="FreeText" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
