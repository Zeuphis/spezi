<UserControl x:Class="Spezi.App.CapturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="HeroClipButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="12" MinHeight="56"/>
              <Border x:Name="Sheen" CornerRadius="12" Opacity="0.9">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                    <GradientStop Color="#38000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ContentPresenter Margin="16,8" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Sheen" Property="Opacity" Value="0.5"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Field}"/>
                <Setter TargetName="Sheen" Property="Opacity" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LiveRecordButton" TargetType="Button">
      <Setter Property="Background" Value="#2A1F23"/>
      <Setter Property="BorderBrush" Value="#6E3036"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" MinHeight="50" Padding="16,6">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Record}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AudioChip" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Bd" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="12,7">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{TemplateBinding Foreground}"/>
                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16,18,8">
      <StackPanel MaxWidth="900">
        <!-- Hero: replay status -->
        <Border x:Name="HeroCard" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18,16">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#2B3037" Offset="0"/>
              <GradientStop Color="#23272D" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse x:Name="StatusPulse" Fill="{DynamicResource Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale" ScaleX="0.5" ScaleY="0.5"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="StatusMark" Width="12" Height="12" Fill="{StaticResource Muted}"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Replay off" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusSub" Text="Turn on to keep your last moments ready to save." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleButton x:Name="ReplayToggle" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"
                            AutomationProperties.Name="Replay" Checked="ReplayToggled" Unchecked="ReplayToggled"/>
            </Grid>
            <WrapPanel Margin="38,12,0,0">
              <Border Style="{StaticResource Chip}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="BufferChipText" FontSize="11" Foreground="{StaticResource Ink}"/></StackPanel></Border>
              <Border Style="{StaticResource Chip}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="QualityChipText" FontSize="11" Foreground="{StaticResource Ink}"/></StackPanel></Border>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Hotkey conflict -->
        <Border x:Name="HotkeyWarning" Background="#332D1C" BorderBrush="#7A6630" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#F2C57C" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="HotkeyWarningText" Grid.Column="1" Foreground="#F2DDB0" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Change hotkeys" Style="{StaticResource LinkButton}" Foreground="#F2C57C" Margin="10,0,0,0" VerticalAlignment="Center" Click="OpenSettingsClick"/>
          </Grid>
        </Border>

        <!-- Primary action -->
        <Button x:Name="ClipButton" Style="{StaticResource HeroClipButton}" Margin="0,14,0,0" Click="SaveClip" AutomationProperties.Name="Save clip">
          <Button.Effect><DropShadowEffect x:Name="ClipGlow" BlurRadius="22" ShadowDepth="0" Opacity="0" Color="#AC8BFA"/></Button.Effect>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Data="M12,3 V13 M7,9 L12,14 L17,9 M5,18 H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" Margin="0,0,9,0"/>
              <TextBlock Text="Save clip" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="7" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center" Background="#33000000" BorderBrush="#55FFFFFF" BorderThickness="1">
              <TextBlock x:Name="ClipHotkeyText" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Border>
          </Grid>
        </Button>
        <TextBlock x:Name="ClipHint" Style="{StaticResource MutedText}" Margin="2,7,2,0" TextAlignment="Center" Visibility="Collapsed"/>

        <Button x:Name="RecordButton" Style="{StaticResource LiveRecordButton}" Margin="0,10,0,0" Click="ToggleRecord" AutomationProperties.Name="Start recording">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Ellipse x:Name="RecordDot" Width="11" Height="11" Fill="{StaticResource Record}" Margin="0,0,9,0"/>
              <TextBlock x:Name="RecordLabel" Text="Start recording" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
              <TextBlock x:Name="RecordTime" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="7" BorderBrush="#6E3036" BorderThickness="1" Padding="9,3" Background="#22000000">
              <TextBlock x:Name="RecordHotkeyText" FontSize="11.5" Foreground="{StaticResource Muted}"/>
            </Border>
          </Grid>
        </Button>

        <!-- Audio -->
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <CheckBox x:Name="SystemBox" Style="{StaticResource AudioChip}" Tag="&#xE767;" Content="App audio" Margin="0,0,8,0" Checked="SystemToggled" Unchecked="SystemToggled" AutomationProperties.Name="App / system audio"/>
          <CheckBox x:Name="MicBox" Grid.Column="1" Style="{StaticResource AudioChip}" Tag="&#xE720;" Content="Mic" Checked="MicToggled" Unchecked="MicToggled" AutomationProperties.Name="Microphone"/>
          <ProgressBar x:Name="MicLevel" Grid.Column="2" Width="54" Height="4" Maximum="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Background="{StaticResource Field}" BorderThickness="0" ToolTip="Microphone level (while replay or recording is active)"/>
          <Button Grid.Column="3" Content="Sources  &gt;" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Click="OpenSettingsClick"/>
        </Grid>
        <TextBlock x:Name="AudioHint" Text="Game audio and voice chat are included." Style="{StaticResource MutedText}" Margin="2,7,0,0"/>

        <!-- Recent clips -->
        <Grid Margin="0,20,0,10">
          <TextBlock Text="Recent clips" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          <Button Content="View all  &gt;" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="ShowAll"/>
        </Grid>
        <Border x:Name="EmptyClips" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,22" Background="#1AFFFFFF">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
            <TextBlock Text="No clips yet" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="Turn on replay and press Save clip to keep a moment." Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>
        <ItemsControl x:Name="RecentList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Click="PlayRecent" Cursor="Hand" Margin="0,0,8,8" ToolTip="Open in default player" AutomationProperties.Name="{Binding Name}" FocusVisualStyle="{StaticResource FocusVisual}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="5">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <StackPanel>
                  <Viewbox Stretch="Uniform">
                    <Grid Width="160" Height="90">
                      <Border CornerRadius="7" Background="{StaticResource Field}" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                      </Border>
                      <Border CornerRadius="5" Background="#CC111418" Padding="5,1" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding DurationText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                      </Border>
                    </Grid>
                  </Viewbox>
                  <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Margin="2,6,2,1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,8">
      <Grid MaxWidth="932">
        <Button x:Name="FolderButton" HorizontalAlignment="Left" Click="OpenFolder" ToolTip="Open folder" AutomationProperties.Name="Open save location"
                Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="4,4">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Field}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <StackPanel Orientation="Horizontal">
            <Path Data="M2,6 H8 L10,8 H20 V18 H2 Z" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="16" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="FolderText" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Width="30" Height="30" Click="OpenSettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings" Margin="0,0,8,0">
            <Grid Width="14" Height="14">
              <Ellipse Stroke="{StaticResource Muted}" StrokeThickness="1.3" Margin="2.6"/>
              <Path Stroke="{StaticResource Muted}" StrokeThickness="1.3" StrokeStartLineCap="Round"
                    Data="M7,0.6 V2.4 M7,11.6 V13.4 M0.6,7 H2.4 M11.6,7 H13.4 M2.4,2.4 L3.6,3.6 M10.4,10.4 L11.6,11.6 M11.6,2.4 L10.4,3.6 M3.6,10.4 L2.4,11.6" Stretch="Fill"/>
            </Grid>
          </Button>
          <TextBlock x:Name="FreeText" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
