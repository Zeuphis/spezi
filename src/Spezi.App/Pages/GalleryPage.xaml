<UserControl x:Class="Spezi.App.GalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
  <UserControl.Resources>
    <Style x:Key="GalleryButton" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource FieldHover}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PreviewButton" TargetType="Button">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <ContextMenu x:Key="ClipMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom">
      <MenuItem Header="Open in default player" Click="Play"/>
      <MenuItem Header="Rename" Click="Rename"/>
      <MenuItem Header="Open folder" Click="OpenItem"/>
      <Separator/>
      <MenuItem Header="Delete" Foreground="{StaticResource Warn}" Click="Delete"/>
    </ContextMenu>
    <Style x:Key="FilterChip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="12,5">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="18,20,18,12" MaxWidth="620">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <Grid Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Gallery" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock x:Name="LibraryText" Text="Your saved moments." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,40,0"/>
        </StackPanel>
        <Button Style="{StaticResource GalleryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenRoot" ToolTip="Open clips folder" AutomationProperties.Name="Open clips folder" Background="Transparent">
          <Path Data="M2,6 H8 L10,8 H20 V18 H2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="16" Height="14" Stretch="Uniform"/>
        </Button>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
        <Border Height="34" CornerRadius="8" BorderThickness="1" Background="{StaticResource Field}">
          <Border.Style>
            <Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
          </Border.Style>
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="Search clips or games" FontSize="11.5" Margin="30,0,28,0" Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0">
              <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/></ControlTemplate></TextBox.Template>
            </TextBox>
            <TextBlock x:Name="SearchPlaceholder" Text="Search clips or games" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="30,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Button x:Name="ClearSearchButton" Style="{StaticResource GalleryButton}" Width="26" Height="26" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed" Click="ClearSearch" ToolTip="Clear search" AutomationProperties.Name="Clear search"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          </Grid>
        </Border>
        <Button x:Name="SortButton" Grid.Column="2" Style="{StaticResource GalleryButton}" Width="96" Click="ToggleSort" ToolTip="Newest first" AutomationProperties.Name="Sort newest first">
          <StackPanel Orientation="Horizontal"><TextBlock x:Name="SortLabel" Text="Newest" FontSize="11.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
        </Button>
      </Grid>
    </StackPanel>
    <Grid Grid.Row="1">
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260" Margin="12">
        <Border Width="52" Height="52" Background="{DynamicResource AccentSoft}" CornerRadius="16" Margin="0,0,0,16"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock x:Name="EmptyTitle" Text="Your first highlight awaits" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
        <TextBlock x:Name="EmptyText" Text="Save a clip while you play. Your moments will show up here." Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
      <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,2,4">
          <!-- Latest clip (page 1, no filter, no search) -->
          <StackPanel x:Name="Hero" Margin="0,0,0,14" Visibility="Collapsed">
            <Border x:Name="HeroCard" CornerRadius="12" ClipToBounds="True" Loaded="RowVisible" Unloaded="RowHidden" DataContextChanged="RowContextChanged" IsVisibleChanged="RowVisibilityChanged">
              <Button x:Name="HeroPlayButton" Style="{StaticResource PreviewButton}" Click="Play" ToolTip="Open in default player" AutomationProperties.Name="Open latest clip in default player" ContextMenu="{StaticResource ClipMenu}">
                <Grid>
                  <Viewbox Stretch="Uniform">
                    <Grid Width="320" Height="180" Background="#181C21">
                      <Grid.Clip><RectangleGeometry Rect="0,0,320,180" RadiusX="10" RadiusY="10"/></Grid.Clip>
                      <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource Line}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                  </Viewbox>
                  <Border Background="#D91B2026" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><TextBlock Text="{Binding Game}" Foreground="{StaticResource Ink}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" TextWrapping="NoWrap"/></Border>
                  <Border x:Name="HeroPlayCircle" Width="44" Height="44" CornerRadius="22" Background="#CC15181C" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M0,0 L0,14 L11,7 Z" Fill="White" Width="11" Height="14" Stretch="Fill" Margin="3,0,0,0"/></Border>
                  <Border Background="{DynamicResource Accent}" CornerRadius="5" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"><TextBlock Text="LATEST" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentInk}"/></Border>
                  <Border Background="#E61B2026" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"><TextBlock Text="{Binding DurationText}" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/></Border>
                </Grid>
              </Button>
            </Border>
            <Grid Margin="2,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock Text="{Binding DetailText}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GalleryButton}" Click="OpenItem" ToolTip="Show in folder" AutomationProperties.Name="Show latest clip in folder" Margin="8,0,0,0">
                  <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button x:Name="ClipMenuButton" Style="{StaticResource GalleryButton}" Click="ShowClipMenu" ToolTip="Clip actions" AutomationProperties.Name="Clip actions" Margin="8,0,0,0" ContextMenu="{StaticResource ClipMenu}">
                  <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- Game filter -->
          <WrapPanel x:Name="GameChips" Margin="0,0,0,6"/>

          <!-- Clip grid (one page) -->
          <ItemsControl x:Name="Clips" Margin="0,0,-8,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel x:Name="ClipCard" Margin="0,0,8,12" Loaded="RowVisible" Unloaded="RowHidden" DataContextChanged="RowContextChanged" IsVisibleChanged="RowVisibilityChanged">
                  <Button x:Name="PlayButton" Style="{StaticResource PreviewButton}" Click="Play" ToolTip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}" ContextMenu="{StaticResource ClipMenu}">
                    <Grid>
                      <Viewbox Stretch="Uniform">
                        <Grid Width="160" Height="90" Background="#181C21">
                          <Grid.Clip><RectangleGeometry Rect="0,0,160,90" RadiusX="8" RadiusY="8"/></Grid.Clip>
                          <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Line}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                      </Viewbox>
                      <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
                      <Border Background="#E61B2026" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"><TextBlock Text="{Binding DurationText}" FontSize="10" FontWeight="SemiBold" Foreground="White"/></Border>
                    </Grid>
                  </Button>
                  <Grid Margin="1,5,1,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource Ink}" TextWrapping="NoWrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Game}" ToolTip="{Binding Game}" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="8,0,0,0"/>
                  </Grid>
                </StackPanel>
                <DataTemplate.Triggers>
                  <Trigger SourceName="PlayButton" Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                  <Trigger SourceName="PlayButton" Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Pager -->
          <StackPanel x:Name="Pager" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4" Visibility="Collapsed"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
