<Window x:Class="Spezi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Spezi"
        Icon="/Assets/Spezi.ico"
        Width="460"
        Height="780"
        MinWidth="400"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="16,0,8,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Height="26" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="/Assets/SpeziMark.png"/>
        <TextBlock Text="Spezi" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindow"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ToggleMaximize"/>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Foreground="{StaticResource Ink}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow"/>
      </StackPanel>
    </Grid>

    <Border x:Name="Tabs" Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="8,0,8,0">
      <UniformGrid Columns="3" MaxWidth="900">
        <Button x:Name="CaptureNav" Style="{StaticResource TabButton}" Click="ShowCapture" AutomationProperties.Name="Recording">
          <StackPanel Orientation="Horizontal">
            <Grid Width="16" Height="16" Margin="0,0,7,0">
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
              <Ellipse Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Grid>
            <TextBlock Text="Recording" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="GalleryNav" Style="{StaticResource TabButton}" Click="ShowGallery" AutomationProperties.Name="Gallery">
          <StackPanel Orientation="Horizontal">
            <Path Width="16" Height="16" Margin="0,0,7,0" Stretch="Uniform" StrokeThickness="1.4"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M1.5,3.5 H14.5 V12.5 H1.5 Z M1.5,10.5 L5,7 L8,9.5 L10.5,7.5 L14.5,11"/>
            <TextBlock Text="Gallery" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="SettingsNav" Style="{StaticResource TabButton}" Click="ShowSettings" AutomationProperties.Name="Settings">
          <StackPanel Orientation="Horizontal">
            <Grid Width="16" Height="16" Margin="0,0,7,0">
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Margin="3.2"/>
              <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                    Data="M8,1.2 V3.2 M8,12.8 V14.8 M1.2,8 H3.2 M12.8,8 H14.8 M3.2,3.2 L4.6,4.6 M11.4,11.4 L12.8,12.8 M12.8,3.2 L11.4,4.6 M4.6,11.4 L3.2,12.8" Stretch="Fill"/>
            </Grid>
            <TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </UniformGrid>
    </Border>

    <ContentControl x:Name="Body" Grid.Row="2"/>
  </Grid>
</Window>
